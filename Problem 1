cat > tests/test_greet.py <<'EOF'
from greetlab import greet


def test_greet_normal_name():
    """正常姓名测试"""
    result = greet("Alice")
    assert result == "Hello, Alice!"


def test_greet_blank_name():
    """空白姓名测试：空字符串 / 全空格"""
    assert greet("") == "Hello!"
    assert greet("   ") == "Hello!"
EOF
